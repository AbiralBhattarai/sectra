FROM python:3.12-slim

# ffmpeg for all media work; Deno is the JS runtime yt-dlp needs to solve YouTube challenges.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
COPY --from=denoland/deno:bin /deno /usr/local/bin/deno

# Silero VAD, pinned to a release and checksummed.
ADD --checksum=sha256:1a153a22f4509e292a94e67d6f9b85e8deb25b4988682b7e174c65279d8788e3 \
    https://github.com/snakers4/silero-vad/raw/v6.2.3/src/silero_vad/data/silero_vad.onnx \
    /opt/models/silero_vad.onnx

COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    VAD_MODEL_PATH=/opt/models/silero_vad.onnx
WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-default-groups --group worker

COPY alembic.ini ./
COPY alembic ./alembic
COPY src ./src

CMD ["python", "-m", "src.worker_main"]
