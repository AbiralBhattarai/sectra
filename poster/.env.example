# Copy to poster/.env. Environment variables override these.

# Sectra writes finished clips here (relative paths are relative to poster/).
OUTBOX_DIR=../data/outbox
# Platforms this poster may post to (youtube, tiktok, instagram, x, facebook).
PLATFORMS=youtube,tiktok,instagram,x

# At most this many posts per platform per day, spread over the active hours (local time)
# with random gaps of +/- JITTER around the even spacing.
POSTS_PER_DAY=10
ACTIVE_HOURS=9-23
JITTER=0.25
# Tries per clip and platform before it is skipped there.
MAX_FAILURES=3

# chrome = your installed Google Chrome (recommended); chromium = Playwright's own
# (then run: uv run playwright install chromium).
BROWSER_CHANNEL=chrome
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
HEADLESS=false

# public, unlisted or private
YOUTUBE_VISIBILITY=public
