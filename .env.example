# Copy to .env. docker compose sets DATABASE_URL / REDIS_URL / DATA_DIR itself;
# the values below are used when running the backend or tests on the host.

LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://sectra:sectra@localhost:5433/sectra
REDIS_URL=redis://localhost:6380/0
DATA_DIR=data

# Worker
# Stable consumer name: un-acked jobs are replayed when the worker restarts.
WORKER_NAME=worker-1
# Jobs run at once per stream.
JOB_CONCURRENCY=4
# Deliveries before a job that keeps crashing the worker is marked failed.
JOB_MAX_ATTEMPTS=3

# Voice activity detection. The model path is fixed by docker compose; on the
# host it defaults to backend/models/silero_vad.onnx (`make models`).
VAD_CONCURRENCY=2

# Speech-to-text. Default: the native GPU Whisper service (`make whisper`, Apple Silicon),
# reached through openai_compat. For CPU-only Whisper inside Docker instead, set
# STT_PROVIDER=faster_whisper and STT_MODEL=small. openai_compat also works with cloud
# APIs (OpenAI, Groq) that return word timestamps.
STT_PROVIDER=openai_compat
# Whisper size for faster_whisper: tiny, base, small, medium, large-v3 (or the API model name).
STT_MODEL=mlx-community/whisper-large-v3-turbo
# Only for openai_compat, e.g. https://api.openai.com/v1 or https://api.groq.com/openai/v1
STT_BASE_URL=http://host.docker.internal:9000/v1
STT_API_KEY=
# Chunks in flight: 2 for the GPU service (it runs one at a time), 1 for local CPU, ~4 for cloud.
STT_CONCURRENCY=2
# ISO code such as en; empty = auto-detect.
STT_LANGUAGE=

# LLM that picks the clips. openai_compat covers Ollama, OpenAI, Groq, OpenRouter,
# LM Studio and vLLM; anthropic is the native Claude API.
LLM_PROVIDER=openai_compat
# Ollama running natively on the Mac (default). Cloud examples:
#   https://api.openai.com/v1   https://api.groq.com/openai/v1   https://openrouter.ai/api/v1
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:14b
# Empty for Ollama; required for cloud providers and anthropic.
LLM_API_KEY=
# Requests in flight at once: 1-2 for local Ollama, ~4 for cloud APIs.
LLM_CONCURRENCY=2
# Seconds of transcript per request. 600 needs an 8k context: set Ollama's context length
# to 8192 (Ollama app -> Settings, or OLLAMA_CONTEXT_LENGTH=8192). Use 300 with a 4k context.
LLM_WINDOW_SECONDS=600

# Clips
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=60
CLIP_MAX_COUNT=10
